{
  "name": "@queryguardhq/queryguard",
  "version": "1.3.1",
  "description": "PostgreSQL migration lock linter and synthetic query-plan smoke test.",
  "main": "dist/index.js",
  "bin": {
    "queryguard": "dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "action.yml",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify --license licenses.txt",
    "lint:sql": "node dist/index.js --lint",
    "test:local": "node dist/index.js --schema test/baseline_dump.sql --migration test/new_migration.sql --queries test/queries.sql",
    "test": "node --import tsx --test test/*.test.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && git diff --exit-code dist/"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "migrations",
    "explain",
    "github-actions",
    "database-linter"
  ],
  "author": "Munir Pathak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/queryguardhq/queryguard.git"
  },
  "homepage": "https://github.com/queryguardhq/queryguard#readme",
  "bugs": {
    "url": "https://github.com/queryguardhq/queryguard/issues"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@vercel/ncc": "^0.38.4",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
